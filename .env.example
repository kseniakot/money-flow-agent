# Telegram bot token (from @BotFather)
TG_TOKEN=

# LM Studio (OpenAI-compatible server)
LM_BASE_URL=http://localhost:1234/v1
LM_MODEL=qwen3-vl-8b-instruct-mlx
LM_API_KEY=lm-studio

# Database
DB_PATH=expenses.sqlite

# LangGraph checkpointer (agent memory, durable across restarts)
CHECKPOINT_PATH=checkpoints.sqlite

# Whisper CLI (already installed system-wide)
WHISPER_BIN=whisper
WHISPER_MODEL=medium

# Default currency for free-text / voice input
DEFAULT_CURRENCY=BYN

# Logging level: DEBUG shows raw model output, INFO the flow
LOG_LEVEL=INFO

# National Bank of Belarus rates API ({cur} is replaced with the currency code)
NBRB_URL=https://api.nbrb.by/exrates/rates/{cur}?parammode=2

# DB backups on startup and daily; keep last N
BACKUP_DIR=backups
BACKUP_KEEP=20
